# Copy to .env (cp .env.example .env) and replace every CHANGE_ME value.
# .env is git-ignored. Never commit real secrets.

# --- PostgreSQL (docker compose "db" service) ---
POSTGRES_DB=findit
POSTGRES_USER=findit
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Spring datasource (host "db" = the compose service name) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/findit

# --- JWT (secret must be at least 32 characters) ---
JWT_SECRET=CHANGE_ME_use_a_long_random_string_of_32_chars_or_more
JWT_EXPIRATION_MS=86400000

# --- Seeded accounts (created on startup if the e-mail does not exist yet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
SECURITY_EMAIL=security@example.com
SECURITY_PASSWORD=CHANGE_ME_security_password

# --- Grafana (optional monitoring stack) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
